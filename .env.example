# Copy to .env (never commit .env). Every value has a safe default for local demos.

# Shared secret for write endpoints (POST/PATCH). Change it for anything beyond a laptop demo.
IIP_API_KEY=change-me-demo-key

# true  = the dashboard receives the key automatically (convenient for demos)
# false = the dashboard asks for the key once per browser session
IIP_DEMO_MODE=true

# Token-bucket rate limit for write endpoints, per client IP.
IIP_RATE_LIMIT_PER_MINUTE=240

# Optional: enables LLM explanations. Without it a deterministic analyst is used (works offline).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works (Azure OpenAI, local gateways, ...).
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional overrides
# IIP_DB_URL=sqlite:///data/iip.db
# IIP_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# IIP_HOST=127.0.0.1
# PORT=8000
